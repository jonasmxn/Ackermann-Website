---
import Rahmen from '../layouts/Rahmen.astro';
import { referenzen } from '../daten/referenzen';
import { angebote } from '../daten/angebote';
import start from '../content/startseite.json';
import leistungen from '../content/leistungen.json';
import unternehmen from '../content/unternehmen.json';
import kontakt from '../content/kontakt.json';
import orteDatei from '../content/orte.json';

const orte = orteDatei.orte.map((o) => ({ ...o, anzahl: referenzen.filter((r) => r.ort === o.name).length }));
const bauarten = ['Wohnen', 'Gewerbe', 'Hallen', 'Kleinbaustellen'].filter((b) => referenzen.some((r) => r.bauart === b));
const anzahlTop = referenzen.filter((r) => r.startseite).length;
const telLink = 'tel:+49' + kontakt.telefon.replace(/\D/g, '').replace(/^0/, '');
const angebot = angebote.find((a) => a.status !== 'Verkauft');
---
<Rahmen titel="Ackermann Bau-GmbH · Bauunternehmen in Andernach seit 1948" beschreibung="Wohnhäuser, Geschäftshäuser und Hallen, massiv und schlüsselfertig gebaut. Bauunternehmen aus Andernach-Miesenheim für die Kreise Mayen-Koblenz, Neuwied und Ahrweiler.">
    <section class="kopfbild" id="top">
      <img src={start.kopfbild} alt={start.kopfbild_text ? `Referenz: ${start.kopfbild_text}` : ''} width="1599" height="1200" fetchpriority="high">
      <div class="innen">
        <div class="ansage">
          <p class="marke">Bauunternehmen · Andernach-Miesenheim</p>
          <h1>{start.titel}</h1>
          <p class="einleitung">{start.einleitung}</p>
          <div class="knoepfe">
            <a class="knopf voll" href="#kontakt">Bauvorhaben anfragen</a>
            <a class="knopf" href="#referenzen">Referenzen ansehen</a>
          </div>
        </div>
      </div>
      {start.kopfbild_text && <p class="bildzeile">{start.kopfbild_text}</p>}
    </section>

    <section class="block" id="leistungen">
      <div class="innen">
        <div class="titel"><p class="marke">Leistungen</p><h2>Was wir für Sie bauen</h2></div>
        <div class="leistungen">
          {leistungen.eintraege.map((l) => (
            <article>
              <h3>{l.slug ? <a href={`/leistungen/${l.slug}/`}>{l.titel}</a> : l.titel}</h3>
              <p>{l.text}</p>
              {l.slug && <a href={`/leistungen/${l.slug}/`}>Mehr erfahren</a>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="block grau" id="bauphasen">
      <div class="innen zwei">
        <div class="titel">
          <p class="marke">Bauablauf</p>
          <h2>{start.phasen_titel}</h2>
          <p>{start.phasen_text}</p>
          <div class="phasen" id="phasen" role="group" aria-label="Bauphase wählen">
            {start.phasen.map((p, i) => (
              <button type="button" data-phase={i} aria-pressed={i === start.phasen.length - 1 ? 'true' : 'false'}>
                <span>{String(i + 1).padStart(2, '0')}</span>{p.name}
              </button>
            ))}
          </div>
          <p id="phase-text">{start.phasen[start.phasen.length - 1].text}</p>
        </div>
        <div class="modell">
          <div class="sicht" id="haus-sicht">
            <canvas id="haus" tabindex="0" aria-label="Drehbares 3D-Modell eines Mehrfamilienhauses in verschiedenen Bauphasen"></canvas>
            <p class="hinweis" id="haus-hinweis">Ziehen zum Drehen</p>
            <p class="stand" id="haus-stand"></p>
          </div>
          <div class="regler">
            <label for="bau">Baufortschritt</label>
            <input type="range" id="bau" min="0" max="100" value="100">
            <div class="zeile">
              <button type="button" id="abspielen">Bau abspielen</button>
              <button type="button" id="drehen" aria-pressed="true">Automatisch drehen</button>
              <button type="button" id="draht" aria-pressed="false">Drahtmodell</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="block" id="referenzen">
      <div class="innen">
        <div class="titel">
          <p class="marke">Referenzen</p>
          <h2>{referenzen.length} Projekte in der Region</h2>
          <p>Wählen Sie eine Bauart oder einen Ort auf der Karte.</p>
        </div>
        <div class="karte">
          <div class="sicht" id="karte-sicht">
            <canvas id="karte" aria-label="Schematische 3D-Karte der Region mit den Orten unserer Referenzen"></canvas>
            <div class="pins" id="pins"></div>
            <p class="hinweis quelle">Karte © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap-Mitwirkende</a> · Gelände überhöht · Zahl = Projekte am Ort</p>
          </div>
        </div>
        <div class="ortwahl" id="ortwahl" role="group" aria-label="Nach Ort filtern">
          {orte.filter((o) => o.anzahl > 0).sort((x, y) => y.anzahl - x.anzahl).map((o) => <button type="button" data-ort={o.name} aria-pressed="false">{o.name} <b>{o.anzahl}</b></button>)}
        </div>
        <div class="filter" id="filter" role="group" aria-label="Nach Bauart filtern">
          <button type="button" data-bauart="" aria-pressed="true">Auswahl</button>
          {bauarten.map((b) => <button type="button" data-bauart={b} aria-pressed="false">{b}</button>)}
          <button type="button" data-alle aria-pressed="false">Alle {referenzen.length}</button>
          <span id="filter-stand" aria-live="polite"></span>
        </div>
        <div class="refs" id="refs">
          {referenzen.map((r) => (
            <article class="ref" data-bauart={r.bauart} data-ort={r.ort} data-top={r.startseite ? '1' : '0'} hidden={!r.startseite}>
              <a href={`/referenzen/${r.slug}/`}><img src={r.bild} alt={`${r.titel}, ${r.ort}`} loading="lazy" width="640" height="480"></a>
              <div>
                <p class="ort">{r.ort} · {r.bauart}</p>
                <h3><a href={`/referenzen/${r.slug}/`}>{r.titel}</a></h3>
                {r.adresse && r.adresse !== r.ort && <p class="adresse">{r.adresse}</p>}
                {(r.baujahr || r.flaeche) && <p class="kenn">{[r.baujahr, r.flaeche].filter(Boolean).join(' · ')}</p>}
                {r.leistungsumfang?.length > 0 && <p class="kenn">{r.leistungsumfang.join(', ')}</p>}
                {r.beschreibung && <p>{r.beschreibung}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="block grau" id="immobilien">
      <div class="innen zwei">
        <div class="titel">
          <p class="marke">Immobilien</p>
          <h2>{start.bauvorhaben_titel}</h2>
          <p>{start.bauvorhaben_text}</p>
          <div class="knoepfe"><a class="knopf voll" href="/immobilien/">Zu den Immobilien</a><a class="knopf" href="#kontakt" data-thema="Immobilie kaufen oder verkaufen">Beratung anfragen</a></div>
        </div>
        {angebot && (
          <article class="angebot">
            <img src={angebot.bild} alt={`${angebot.titel}, ${angebot.ort}`} loading="lazy" width="640" height="480">
            <div><p class="ort">{angebot.status} · {angebot.ort}</p><h3><a href="/immobilien/">{angebot.titel}</a></h3></div>
          </article>
        )}
      </div>
    </section>

    <section class="block" id="unternehmen">
      <div class="innen zwei">
        <img class="portrait" src={unternehmen.bild} alt="Von der Ackermann Bau-GmbH gebautes Mehrfamilienhaus" loading="lazy" width="640" height="640">
        <div class="titel">
          <p class="marke">Unternehmen</p>
          <h2>{unternehmen.titel}</h2>
          <p>{unternehmen.text}</p>
          <ol class="stationen">
            {unternehmen.stationen.map((s) => <li><b>{s.jahr}</b><span>{s.text}</span></li>)}
          </ol>
          <a class="knopf" href="/unternehmen/">Mehr über uns</a>
        </div>
      </div>
      <div class="innen">
        <p class="marke">Partner und Verbände</p>
        <ul class="partner">
          {unternehmen.partner.map((p) => <li><a href={p.url} rel="noopener"><img src={p.logo} alt={p.name} loading="lazy"></a></li>)}
        </ul>
      </div>
    </section>

    <section class="block grau kontakt" id="kontakt">
      <div class="innen zwei">
        <div class="titel">
          <p class="marke">Kontakt</p>
          <h2>Erzählen Sie uns von Ihrem Bauvorhaben</h2>
          <p>Drei kurze Fragen, dann melden wir uns bei Ihnen. Oder Sie rufen direkt an.</p>
          <p class="gross"><a href={telLink}>{kontakt.telefon}</a></p>
          <address>
            {kontakt.firma}<br>{kontakt.strasse}, {kontakt.ort}<br>
            {kontakt.zeiten}<br>
            <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
          </address>
        </div>
        <form id="anfrage" name="anfrage" method="POST" data-netlify="true" netlify-honeypot="website" data-email={kontakt.email} novalidate>
          <input type="hidden" name="form-name" value="anfrage">
          <p class="honig" aria-hidden="true"><label>Bitte leer lassen <input name="website" tabindex="-1" autocomplete="off"></label></p>
          <p class="schritt" id="schritt-stand">Frage 1 von 3</p>
          <fieldset data-schritt="0">
            <legend>Was möchten Sie bauen?</legend>
            <div class="wahl">
              {['Einfamilienhaus', 'Mehrfamilienhaus', 'Halle oder Gewerbebau', 'Sanierung oder Kleinbaustelle', 'Immobilie kaufen oder verkaufen'].map((t, i) => (
                <label><input type="radio" name="thema" value={t} checked={i === 0}><span>{t}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset data-schritt="1" hidden>
            <legend>Wo und wann?</legend>
            <label for="f-ort">Ort des Bauvorhabens</label>
            <input id="f-ort" name="ort" type="text" autocomplete="address-level2" placeholder="z. B. Andernach">
            <label for="f-zeit">Gewünschter Baubeginn</label>
            <select id="f-zeit" name="zeit">
              <option>Noch offen</option><option>In den nächsten 6 Monaten</option><option>In 6 bis 12 Monaten</option><option>Später</option>
            </select>
          </fieldset>
          <fieldset data-schritt="2" hidden>
            <legend>Wie erreichen wir Sie?</legend>
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required>
            <label for="f-tel">Telefon</label>
            <input id="f-tel" name="tel" type="tel" autocomplete="tel">
            <label for="f-mail">E-Mail</label>
            <input id="f-mail" name="email" type="email" autocomplete="email">
            <label for="f-text">Nachricht (freiwillig)</label>
            <textarea id="f-text" name="text" rows="3"></textarea>
            <p class="fehler" id="f-fehler" role="alert" hidden></p>
          </fieldset>
          <div class="zeile">
            <button type="button" id="zurueck" hidden>Zurück</button>
            <button type="button" class="voll" id="weiter">Weiter</button>
            <button type="submit" class="voll" id="senden" hidden>Anfrage senden</button>
          </div>
          <p class="klein" id="f-hinweis">Ihre Angaben verwenden wir nur, um Ihre Anfrage zu beantworten. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
          <div class="gesendet" id="f-gesendet" role="status" hidden>
            <h3>Vielen Dank, Ihre Anfrage ist bei uns angekommen.</h3>
            <p>Wir melden uns bei Ihnen. Bürozeiten: {kontakt.zeiten}.</p>
          </div>
        </form>
      </div>
    </section>

  <script slot="skripte" type="application/json" id="daten" set:html={JSON.stringify({ phasen: start.phasen, orte })}></script>
  <script>
    import { initHaus } from '../scripts/haus.js';
    import { initKarte } from '../scripts/karte.js';
    const daten = JSON.parse(document.getElementById('daten').textContent);
    const $ = (s, el = document) => el.querySelector(s);
    const $$ = (s, el = document) => [...el.querySelectorAll(s)];

    // Bauphasen-Modell
    const bau = $('#bau'), stand = $('#haus-stand'), phaseText = $('#phase-text');
    const phaseVon = (s) => (s.bau < 4 ? 0 : s.mode === 'roh' || s.bau < 100 ? (s.bau >= 100 ? 2 : 1) : 3);
    const haus = initHaus({
      container: $('#haus-sicht'), canvas: $('#haus'),
      onChange(s) {
        bau.value = s.bau;
        stand.textContent = `Baufortschritt ${Math.round(s.bau)} %`;
        const p = s.mode === 'draht' ? -1 : phaseVon(s);
        $$('#phasen button').forEach((b, i) => b.setAttribute('aria-pressed', i === p ? 'true' : 'false'));
        if (p >= 0) phaseText.textContent = daten.phasen[p].text;
        $('#drehen').setAttribute('aria-pressed', s.spin ? 'true' : 'false');
        $('#draht').setAttribute('aria-pressed', s.mode === 'draht' ? 'true' : 'false');
      },
    });
    if (haus) {
      const zeige = [() => { haus.setMode('roh'); haus.setBau(2.5); }, () => { haus.setMode('roh'); haus.setBau(62); },
        () => { haus.setMode('roh'); haus.setBau(100); }, () => { haus.setMode('fertig'); haus.setBau(100); }];
      $$('#phasen button').forEach((b) => b.addEventListener('click', () => zeige[+b.dataset.phase]()));
      bau.addEventListener('input', () => haus.setBau(+bau.value));
      $('#abspielen').addEventListener('click', () => haus.play());
      $('#drehen').addEventListener('click', () => haus.toggleSpin());
      $('#draht').addEventListener('click', (e) => haus.setMode(e.currentTarget.getAttribute('aria-pressed') === 'true' ? 'fertig' : 'draht'));
      haus.setMode('fertig');
      // Der Bau läuft einmal ab, wenn das Modell zum ersten Mal ins Bild kommt
      if (!haus.reduced) {
        const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { io.disconnect(); haus.play(); } }, { threshold: 0.6 });
        io.observe($('#haus-sicht'));
      }
    } else {
      $('#haus-hinweis').textContent = '3D wird von diesem Gerät nicht unterstützt';
    }

    // Referenzen: Filter und Karte
    const zustand = { bauart: '', ort: '', alle: false };
    const refs = $$('#refs .ref');
    let karte = null;
    function filtern() {
      let n = 0;
      const frei = !zustand.bauart && !zustand.ort && !zustand.alle;
      for (const r of refs) {
        const ok = (!zustand.bauart || r.dataset.bauart === zustand.bauart) && (!zustand.ort || r.dataset.ort === zustand.ort) && (!frei || r.dataset.top === '1');
        r.hidden = !ok; if (ok) n++;
      }
      $$('#filter button').forEach((b) => {
        const an = 'alle' in b.dataset ? zustand.alle && !zustand.bauart : b.dataset.bauart === zustand.bauart && !(b.dataset.bauart === '' && (zustand.alle || zustand.ort));
        b.setAttribute('aria-pressed', an ? 'true' : 'false');
      });
      $('#filter-stand').textContent = `${n} von ${refs.length}` + (zustand.ort ? ` · ${zustand.ort}` : '');
      $$('#ortwahl button').forEach((b) => b.setAttribute('aria-pressed', b.dataset.ort === zustand.ort ? 'true' : 'false'));
      karte && karte.markiere(zustand.ort);
    }
    $('#filter').addEventListener('click', (e) => {
      const b = e.target.closest('button'); if (!b) return;
      if ('alle' in b.dataset) Object.assign(zustand, { alle: true, bauart: '', ort: '' });
      else Object.assign(zustand, { bauart: b.dataset.bauart, alle: false, ort: b.dataset.bauart === '' ? '' : zustand.ort });
      filtern();
    });
    $('#ortwahl').addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; zustand.ort = zustand.ort === b.dataset.ort ? '' : b.dataset.ort; filtern(); });
    $$('[data-zeige]').forEach((a) => a.addEventListener('click', () => { Object.assign(zustand, { bauart: a.dataset.zeige, ort: '', alle: false }); filtern(); }));
    karte = initKarte({
      container: $('#karte-sicht'), canvas: $('#karte'), labels: $('#pins'), orte: daten.orte,
      onPick(name) { zustand.ort = zustand.ort === name ? '' : name; filtern(); },
    });
    filtern();

    // Anfrage in drei Schritten
    const form = $('#anfrage'), schritte = $$('fieldset', form);
    let nr = 0;
    function schritt(n) {
      nr = n;
      schritte.forEach((f, i) => { f.hidden = i !== n; });
      $('#zurueck').hidden = n === 0; $('#weiter').hidden = n === 2; $('#senden').hidden = n !== 2;
      $('#schritt-stand').textContent = `Frage ${n + 1} von 3`;
    }
    $('#weiter').addEventListener('click', () => { schritt(nr + 1); schritte[nr].querySelector('input,select').focus(); });
    $('#zurueck').addEventListener('click', () => schritt(nr - 1));
    $$('[data-thema]').forEach((a) => a.addEventListener('click', () => {
      const r = $$('input[name=thema]', form).find((i) => i.value === a.dataset.thema); if (r) r.checked = true;
    }));
    const fehler = (text, feld) => { const f = $('#f-fehler'); f.textContent = text; f.hidden = !text; if (feld) feld.focus(); };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const d = new FormData(form);
      if (!String(d.get('name')).trim()) return fehler('Bitte geben Sie Ihren Namen an.', $('#f-name'));
      const mail = String(d.get('email')).trim(), tel = String(d.get('tel')).trim();
      if (!mail && !tel) return fehler('Bitte geben Sie eine Telefonnummer oder E-Mail-Adresse an, damit wir Sie erreichen.', $('#f-tel'));
      if (mail && !/^\S+@\S+\.\S+$/.test(mail)) return fehler('Bitte prüfen Sie die E-Mail-Adresse.', $('#f-mail'));
      fehler('');
      const knopf = $('#senden'); knopf.disabled = true; knopf.textContent = 'Wird gesendet';
      let ok = false;
      try {
        const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(d).toString() });
        ok = r.ok;
      } catch (err) { ok = false; }
      if (ok) {
        schritte.forEach((f) => { f.hidden = true; });
        for (const id of ['#schritt-stand', '#zurueck', '#weiter', '#senden', '#f-hinweis']) $(id).hidden = true;
        $('#f-gesendet').hidden = false;
        return;
      }
      // Der direkte Versand hat nicht geklappt: Die Anfrage geht ersatzweise über das E-Mail-Programm des Besuchers
      knopf.disabled = false; knopf.textContent = 'Anfrage senden';
      const text = [`Bauvorhaben: ${d.get('thema')}`, `Ort: ${d.get('ort') || 'keine Angabe'}`, `Baubeginn: ${d.get('zeit')}`, `Name: ${d.get('name')}`,
        `Telefon: ${tel || 'keine Angabe'}`, `E-Mail: ${mail || 'keine Angabe'}`, '', d.get('text') || ''].join('\n');
      fehler('Die Anfrage konnte nicht direkt gesendet werden. Wir öffnen sie stattdessen in Ihrem E-Mail-Programm.');
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Anfrage: ' + d.get('thema'))}&body=${encodeURIComponent(text)}`;
    });
  </script>
</Rahmen>
